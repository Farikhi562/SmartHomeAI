{
  "name": "smarthomeai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered personal belongings memory platform",
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ai": "vitest run tests/ai-evaluation",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.ts",
    "db:studio": "prisma studio",
    "validate:docs": "node tools/validate-docs.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@prisma/client": "^6.19.0",
    "jose": "^5.9.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
