# SmartHomeAI — environment variables (TEMPLATE ONLY — never put real secrets here)
# Copy to `.env.local` for local development (gitignored).
# Cloud environments get these from AWS Secrets Manager / Amplify environment settings.

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL 16) — Supabase (D2/ADR-005); Docker Compose is an
# optional local fallback only. Get both strings from Supabase ▸ Connect:
#   DATABASE_URL = pooled runtime URL (Supavisor transaction mode, port 6543,
#                  ?pgbouncer=true) — Prisma Client runtime queries.
#   DIRECT_URL   = direct connection (db.<ref>.supabase.co:5432) for Prisma
#                  Migrate/Studio; if IPv6 is unavailable use the session-mode
#                  pooler string (port 5432) instead.
# (docs/architecture/DATABASE_SCHEMA.md §6, ADR-005)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres"

# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
LOG_LEVEL="info"                    # debug | info | warn | error — content never logged

# ─────────────────────────────────────────────────────────────
# Auth — Supabase Auth (D5 amended, ADR-005; docs/architecture/SECURITY.md)
# "dev"    = local email-only login (development only; refused in production)
# "supabase" = verify GoTrue access tokens (HS256, iss=<SUPABASE_URL>/auth/v1)
# Values come from Supabase ▸ Project Settings ▸ API.
# ─────────────────────────────────────────────────────────────
AUTH_MODE="supabase"
SUPABASE_URL="https://<PROJECT-REF>.supabase.co"
SUPABASE_ANON_KEY="REPLACE_WITH_ANON_KEY"
SUPABASE_JWT_SECRET="REPLACE_WITH_JWT_SECRET"

# ─────────────────────────────────────────────────────────────
# AI — Groq (server-side only; NEVER expose via NEXT_PUBLIC_*)
# docs/architecture/AI_ARCHITECTURE.md
# ─────────────────────────────────────────────────────────────
GROQ_API_KEY="REPLACE_WITH_GROQ_KEY"
GROQ_MODEL="llama-3.3-70b-versatile"   # configurable; verify availability at implementation time
GROQ_TIMEOUT_MS="15000"                # hard ceiling per attempt
GROQ_MAX_RETRIES="2"                   # retry only on 429/5xx/network

# ─────────────────────────────────────────────────────────────
# Limits (business rules BR-12) — server-side enforced
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_ASSISTANT_PER_MIN="20"
RATE_LIMIT_WRITES_PER_MIN="60"
RATE_LIMIT_READS_PER_MIN="120"
ASSISTANT_DAILY_MESSAGE_CAP_PER_USER="100"

# ─────────────────────────────────────────────────────────────
# AWS (cloud environments only; local dev needs none of these)
# Used by infrastructure/ CDK and runtime adapters (S3 for P1 images)
# ─────────────────────────────────────────────────────────────
AWS_REGION="us-east-1"
# AWS account IDs are NEVER hardcoded; CDK resolves from the active profile/CI role.
# Secrets are referenced by ARN or resolved from Secrets Manager at deploy time:
# SECRETS_ARN_GROQ="/apps/smarthomeai/<env>/groq-api-key"
# SECRETS_ARN_DB="/apps/smarthomeai/<env>/database-url"

# ─────────────────────────────────────────────────────────────
# Optional / P1 features
# ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL="http://localhost:3000"    # client-visible URL when needed
# S3_UPLOAD_BUCKET=""                            # P1 item images (FR-025)
