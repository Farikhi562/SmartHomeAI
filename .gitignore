infrastructure/cdk.out/
cdk.context.json
.amplify/

# Logs / caches / OS
*.log
npm-debug.log*
.eslintcache
.cache/
.tmp/
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

